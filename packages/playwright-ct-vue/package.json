{
  "name": "@shopby/playwright-ct-vue",
  "version": "1.52.0",
  "description": "Playwright Component Testing for Vue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/playwright.git"
  },
  "homepage": "https://playwright.dev",
  "engines": {
    "node": ">=18"
  },
  "author": {
    "name": "Microsoft Corporation"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build:watch": "tsc --watch || echo 'tsc --watch를 사용하려면 tsconfig.json과 typescript가 필요합니다.'",
    "pack": "npm pack",
    "publish": "npm publish --access public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./register": {
      "types": "./register.d.ts",
      "default": "./register.mjs"
    },
    "./hooks": {
      "types": "./hooks.d.ts",
      "default": "./hooks.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@shopby/playwright-ct-core": "1.52.0",
    "@vitejs/plugin-vue": "^5.2.0"
  },
  "bin": {
    "playwright": "cli.js"
  }
}
